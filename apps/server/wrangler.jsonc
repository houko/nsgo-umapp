{
  "name": "umapp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    // Found by name, without an id: `npm run deploy` creates it the first time.
    { "binding": "DB", "database_name": "umapp", "migrations_dir": "migrations" }
  ]
  // The API key Umapp connects with is the API_KEY secret, which `npm run deploy` makes the first time; for `npm run dev`, set it in .dev.vars.
}
